# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE ADSENSE CONFIGURATION
# Set your Google AdSense Publisher Client ID (e.g., ca-pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_CLIENT_ID="ca-pub-0000000000000000"

# Google AdSense Unit Slot IDs (optional - fallbacks provided)
VITE_ADSENSE_SLOT_HEADER="1234567890"
VITE_ADSENSE_SLOT_SIDEBAR="2345678901"
VITE_ADSENSE_SLOT_BELOW_TOOL="3456789012"
VITE_ADSENSE_SLOT_MODAL="4567890123"
VITE_ADSENSE_SLOT_INFLOW="5678901234"

# RENDER HOST KEEP-ALIVE CONFIGURATION
# Render free tier host spins down after 50s of inactivity.
# Client pings /ping every 40,000 ms (40 seconds).
VITE_KEEP_ALIVE_INTERVAL_MS=40000
